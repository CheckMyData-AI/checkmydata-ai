// The site on Cloudflare Workers (2026-10-12). Static export in ./out, the Worker in
// worker/index.ts runs first only for /api/* (the waitlist). The account comes from
// CLOUDFLARE_ACCOUNT_ID at deploy time; RESEND_API_KEY is a Worker secret.
// The route checkmydata.ai/* is NOT here: it is a zone right the deploy token does not
// hold, so `scripts/attach-site-route.mjs` attaches it with its own zone-scoped token.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkmydata-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "WAITLIST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "WAITLIST_TO": "contact@checkmydata.ai"
  },
  "workers_dev": true,
  "observability": { "enabled": true }
}
