# syntax=docker/dockerfile:1.7

# ---------- builder ----------
# Compiles native deps (asyncpg, cryptography, chromadb, etc.) into an isolated
# virtualenv so the runtime image stays small and free of build tooling (T33).
FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libpq-dev \
        git \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
RUN python -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /build

COPY backend/pyproject.toml .
RUN pip install --upgrade pip && \
    pip install ".[redis]"

# ---------- runtime ----------
FROM python:3.12-slim AS runtime

# The commit this image was built from, baked in at build time.
#
# `HEROKU_SLUG_COMMIT` — which the Sentry docs and most guides tell you to use — is
# populated only for slug (buildpack) deploys. This app is on the **container** stack,
# where the variable exists and is always EMPTY (measured on v271, 2026-08-26). A Sentry
# release built from it would be blank, issues would attach to a release with no commits,
# and suspect-commit attribution would silently do nothing — which reads as "Sentry is
# not very good" rather than as a wiring bug.
#
# The build already knows the SHA: `deploy.yml` checks out `workflow_run.head_sha`. An
# image-baked value is also the honest one, because it cannot drift from the code inside
# the image the way a config variable set separately can.
ARG GIT_SHA=""
ENV RELEASE=$GIT_SHA

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        openssh-client \
        libpq5 \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

COPY backend/ .

RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --ingroup appgroup appuser && \
    mkdir -p data rules && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

# Container-level healthcheck — independent of the platform's L4 probe.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/api/health" || exit 1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
